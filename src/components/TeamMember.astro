---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  role: string;
  bio: string;
  image?: string;
}

const { name, role, bio, image } = Astro.props;
const initials = name.split(' ').map(n => n[0]).join('').slice(0, 2);

// Only render an <img> if the file actually exists in public/ — otherwise a
// not-yet-supplied photo shows a broken-image icon instead of the initials.
const hasImage = !!image && fs.existsSync(path.join(process.cwd(), 'public', image));
---

<div class="bg-white border border-border rounded-xl p-6 flex gap-5">
  {hasImage ? (
    <img
      src={image}
      alt={name}
      class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover object-top flex-shrink-0"
      loading="lazy"
    />
  ) : (
    <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-teal text-white flex items-center justify-center text-2xl font-bold flex-shrink-0">
      {initials}
    </div>
  )}
  <div>
    <h3 class="font-semibold text-gray-dark text-lg">{name}</h3>
    <p class="text-xs uppercase tracking-wider text-teal font-semibold mt-0.5">{role}</p>
    <p class="text-sm text-gray-mid mt-2 leading-relaxed">{bio}</p>
  </div>
</div>
